:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #ecf4ff;
  background: #07111d;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
}

body {
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at top, rgba(96, 165, 250, 0.2), transparent 38%),
    linear-gradient(135deg, #020817 0%, #07111d 46%, #0b1321 100%);
}

button,
textarea,
select {
  font: inherit;
}

button {
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: transform 0.16s ease, opacity 0.16s ease, box-shadow 0.16s ease;
}

button:hover {
  transform: translateY(-1px);
}

.app-shell {
  width: min(950px, 92vw);
}

.landing-card,
.game-panel {
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 28px;
  box-shadow: 0 30px 80px rgba(2, 6, 23, 0.7);
}

.landing-card {
  display: grid;
  grid-template-columns: 1.2fr 0.9fr;
  gap: 22px;
  padding: 30px;
}

.brand-block {
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: linear-gradient(135deg, rgba(14, 116, 144, 0.18), rgba(37, 99, 235, 0.22));
  border: 1px solid rgba(125, 211, 252, 0.2);
  border-radius: 22px;
  padding: 28px;
}

.eyebrow {
  display: inline-flex;
  align-self: flex-start;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #7dd3fc;
  margin-bottom: 12px;
}

h1 {
  margin: 0;
  font-size: clamp(2.5rem, 4vw, 4rem);
  line-height: 1;
}

.brand-block p {
  margin: 14px 0 0;
  max-width: 30rem;
  color: #cbd5e1;
  font-size: 1.08rem;
}

.menu-panel,
.leaderboard-panel {
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 18px;
  padding: 18px;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 16px;
}

.field-group label {
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #a7c0db;
}

select {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.9);
  color: #edf6ff;
  padding: 12px 14px;
}

.primary-button,
.secondary-button {
  padding: 12px 18px;
  font-weight: 700;
}

.primary-button {
  width: 100%;
  background: linear-gradient(135deg, #38bdf8, #2563eb);
  color: #eff6ff;
  box-shadow: 0 12px 30px rgba(37, 99, 235, 0.35);
}

.secondary-button {
  background: rgba(148, 163, 184, 0.12);
  color: #edf6ff;
  border: 1px solid rgba(148, 163, 184, 0.18);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

.panel-header h2 {
  margin: 0;
  font-size: 1.2rem;
}

.panel-header span {
  color: #9db4c9;
  font-size: 0.82rem;
}

.leaderboard-list {
  list-style: none;
  padding: 0;
  margin: 16px 0 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.leaderboard-list li {
  display: grid;
  grid-template-columns: 42px 1fr auto;
  gap: 12px;
  align-items: center;
  padding: 10px 12px;
  border-radius: 12px;
  background: rgba(148, 163, 184, 0.06);
}

.leaderboard-list span,
.leaderboard-list strong,
.leaderboard-list small {
  display: block;
}

.leaderboard-list small {
  color: #a7c0db;
}

.empty-state {
  margin: 16px 0 0;
  color: #cbd5e1;
}

.game-panel {
  padding: 24px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.topbar h1 {
  font-size: clamp(2rem, 4vw, 2.7rem);
}

.header-actions {
  display: flex;
  gap: 10px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 16px;
  margin-bottom: 18px;
}

.stat-box {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 16px;
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.label {
  font-size: 0.76rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #9db4c9;
}

.stat-box strong {
  font-size: clamp(1.3rem, 3vw, 1.8rem);
}

.text-display {
  min-height: 180px;
  border-radius: 18px;
  border: 1px solid rgba(148, 163, 184, 0.15);
  background: rgba(15, 23, 42, 0.78);
  padding: 20px 18px;
  font-size: 1.2rem;
  line-height: 1.9;
  letter-spacing: 0.03em;
  margin-bottom: 18px;
}

.char {
  border-radius: 4px;
  transition: background 0.12s ease, color 0.12s ease;
}

.char.correct {
  color: #86efac;
}

.char.incorrect {
  background: rgba(239, 68, 68, 0.16);
  color: #fca5a5;
}

.char.current {
  background: rgba(96, 165, 250, 0.2);
  box-shadow: inset 0 0 0 1px rgba(125, 211, 252, 0.7);
}

textarea {
  width: 100%;
  min-height: 120px;
  resize: vertical;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(2, 6, 23, 0.8);
  color: #f8fbff;
  border-radius: 16px;
  padding: 16px 18px;
  font-size: 1.06rem;
  line-height: 1.6;
  outline: none;
}

textarea:focus {
  border-color: rgba(96, 165, 250, 0.9);
  box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.18);
}

textarea:disabled {
  cursor: not-allowed;
  opacity: 0.7;
}

.result-banner {
  margin-top: 20px;
  border-radius: 16px;
  background: rgba(34, 197, 94, 0.12);
  border: 1px solid rgba(34, 197, 94, 0.28);
  color: #dcfce7;
  padding: 18px;
}

.result-banner strong {
  display: block;
  margin-bottom: 6px;
  font-size: 1.05rem;
}

.result-banner p {
  margin: 0;
  color: #e2fbe8;
}

.result-actions {
  display: flex;
  gap: 10px;
  margin-top: 16px;
}

@media (max-width: 760px) {
  .landing-card {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .header-actions {
    width: 100%;
  }

  .header-actions button {
    flex: 1;
  }
}

@media (max-width: 540px) {
  .game-panel,
  .landing-card {
    padding: 18px;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .result-actions {
    flex-direction: column;
  }
}
