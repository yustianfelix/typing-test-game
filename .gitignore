* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #e5eefb;
  background: #081120;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
}

body {
  display: grid;
  place-items: center;
  background: radial-gradient(circle at top, #10213a 0%, #091421 45%, #050b13 100%);
}

button,
textarea {
  font: inherit;
}

.app-shell {
  width: min(900px, 92vw);
}

.game-panel {
  background: rgba(15, 23, 42, 0.88);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 30px 80px rgba(3, 7, 18, 0.55);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 2.8rem);
}

.restart {
  border: none;
  border-radius: 12px;
  background: rgba(96, 165, 250, 0.15);
  color: #dfeeff;
  padding: 10px 16px;
  cursor: pointer;
  transition: transform 0.2s ease, background 0.2s ease;
}

.restart:hover {
  transform: translateY(-1px);
  background: rgba(96, 165, 250, 0.25);
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 16px;
  margin-bottom: 20px;
}

.stat-box {
  background: #111c2b;
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 14px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.label {
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #9fb4c9;
}

.stat-box strong {
  font-size: clamp(1.2rem, 2vw, 1.8rem);
}

.text-display {
  min-height: 150px;
  border-radius: 16px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(15, 23, 42, 0.8);
  padding: 22px 18px;
  font-size: 1.2rem;
  line-height: 2;
  letter-spacing: 0.03em;
  margin-bottom: 18px;
}

.char {
  border-radius: 4px;
  transition: background 0.12s ease, color 0.12s ease;
}

.char.correct {
  color: #86efac;
}

.char.incorrect {
  background: rgba(239, 68, 68, 0.14);
  color: #fca5a5;
}

.char.current {
  background: rgba(96, 165, 250, 0.26);
  box-shadow: inset 0 0 0 1px rgba(125, 211, 252, 0.7);
}

textarea {
  width: 100%;
  min-height: 120px;
  resize: vertical;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(2, 6, 23, 0.75);
  color: #f8fbff;
  border-radius: 14px;
  padding: 16px 18px;
  font-size: 1.06rem;
  line-height: 1.6;
  outline: none;
}

textarea:focus {
  border-color: rgba(96, 165, 250, 0.8);
  box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.18);
}

textarea:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.result-banner {
  margin-top: 18px;
  text-align: center;
  border-radius: 12px;
  background: rgba(34, 197, 94, 0.12);
  border: 1px solid rgba(34, 197, 94, 0.25);
  color: #dcfce7;
  padding: 14px;
  font-weight: 600;
}

@media (max-width: 600px) {
  .game-panel {
    padding: 18px;
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .stats {
    grid-template-columns: 1fr;
  }
}
